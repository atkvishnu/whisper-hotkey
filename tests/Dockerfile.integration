FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git curl alsa-utils pulseaudio pulseaudio-utils \
    xvfb xclip wl-clipboard libnotify-bin
COPY . /project
WORKDIR /project
RUN ./install.sh --skip-deps --prefix /opt/whisper-hotkey --model tiny.en
RUN apt-get update && apt-get install -y --no-install-recommends sway \
    && useradd -m whisper-test \
    && chmod 0644 /opt/whisper-hotkey/whisper.cpp/models/ggml-tiny.en.bin
# The public model fixture is shared with the unprivileged Wayland test user.
# Recordings and transcripts remain inside each test user's private state directory.
CMD ["sh", "-c", "python3 tests/linux_desktop_e2e.py /opt/whisper-hotkey && su -s /bin/sh whisper-test -c 'cd /project && python3 tests/wayland_clipboard_e2e.py /opt/whisper-hotkey'"]
